# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
build/
/release/
.tmp/
*.tsbuildinfo
.next/
.turbo/

# Environment
.env
.env.local
.env.*.local
*.pem
secrets*

# Logs
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Editor
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.swp
.DS_Store

# Test / coverage
coverage/
.nyc_output/
__pycache__/
*.py[cod]

# Session data (event logs will land here)
sessions/
.agent-kernel/

# Reference projects (cloned for study, not committed)
references/
.presq/

# Agent scratch
.claude/
.agent-home/
.claude-home/

# Experiment-local heavy/raw evidence. Small summaries, reports, diagnostics,
# and plans live outside artifacts so gitignore stays simple.
experiments/**/.venv*/
experiments/**/artifacts/

# Defensive ignores for misplaced runtime output.
experiments/**/*.tar
experiments/**/*.tar.gz
experiments/**/workspace/
experiments/**/workspaces/

# Per-package scratch directories (local debug/probe scripts, not committed)
packages/*/scratch/
