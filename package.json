{
  "name": "agent-kernel",
  "version": "0.0.0",
  "private": true,
  "description": "Agent RunLab backend and dashboard for replayable agent sessions, benchmarks, and RL rollout integration.",
  "packageManager": "pnpm@11.3.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "prepare:socket-admin-ui": "node scripts/release/fetch-socket-admin-ui.mjs",
    "build:release-assets": "node scripts/release/build-release-assets.mjs",
    "deploy:remote": "node scripts/deploy/deploy-remote.mjs",
    "verify:release-assets": "node scripts/release/verify-release-assets.mjs",
    "verify:supply-chain": "node scripts/security/verify-supply-chain.mjs",
    "verify:release-install": "node scripts/release/verify-release-install.mjs",
    "test": "pnpm -r --workspace-concurrency=1 run test",
    "typecheck": "pnpm -r --parallel run typecheck",
    "lint:style": "pnpm --filter @agent-kernel/dashboard lint:style",
    "dev:all": "pnpm -r --parallel run dev",
    "verify:dashboard-real": "pnpm --filter @agent-kernel/dashboard verify:real",
    "verify:dashboard-debugger": "pnpm --filter @agent-kernel/dashboard verify:debugger",
    "verify:dashboard-layout-scroll": "pnpm --filter @agent-kernel/dashboard verify:layout-scroll",
    "verify:dashboard-mobile-pwa": "pnpm --filter @agent-kernel/dashboard verify:mobile-pwa",
    "verify:dashboard-enhancement-actions": "pnpm --filter @agent-kernel/dashboard verify:enhancement-actions",
    "verify:dashboard-subagent-scroll": "pnpm --filter @agent-kernel/dashboard verify:subagent-scroll",
    "verify:dashboard-top-pages": "node scripts/dashboard/verify-dashboard-top-pages.mjs",
    "verify:swebench-smoke": "node scripts/eval/benchmarks/swebench/verify-swebench-smoke.mjs",
    "verify:tasks-button": "node scripts/dashboard/verify-tasks-button.mjs",
    "benchmarks:sync-env": "node scripts/eval/benchmarks/core/sync-benchmark-env.mjs",
    "benchmarks:preflight": "node scripts/eval/benchmarks/core/audit-benchmark-env-preflight.mjs",
    "benchmarks:validate": "node scripts/eval/benchmarks/core/aggregate-agent-benchmark-comparison.mjs && node scripts/eval/benchmarks/core/audit-benchmark-artifacts.mjs && node scripts/eval/benchmarks/core/audit-benchmark-objective-coverage.mjs && node scripts/eval/benchmarks/core/validate-agent-benchmark-comparison.mjs",
    "dashboard:dev": "pnpm --filter @agent-kernel/dashboard dev",
    "host:dev": "pnpm --filter @agent-kernel/host dev",
    "executor:dev": "pnpm --filter @agent-kernel/executor dev",
    "publish:kernel": "pnpm --filter @agent-kernel/kernel run publish:npm",
    "publish:host": "pnpm --filter @agent-kernel/host run publish:npm",
    "publish:executor": "pnpm --filter @agent-kernel/executor run publish:npm",
    "publish:all": "pnpm run publish:kernel && pnpm run publish:host && pnpm run publish:executor",
    "perf:scenario": "pnpm --filter @agent-kernel/perf-harness scenario",
    "perf:regression": "pnpm --filter @agent-kernel/perf-harness perf",
    "saas:secrets": "node scripts/saas-local/generate-secrets.mjs",
    "saas:validate": "node scripts/saas-local/validate-compose-policy.mjs",
    "saas:check": "node scripts/saas-local/preflight.mjs",
    "saas:deploy": "node scripts/saas-local/deploy-profile.mjs apply",
    "saas:manifest": "node scripts/saas-local/release-manifest.mjs",
    "saas:bootstrap-zitadel": "node scripts/saas-local/bootstrap-zitadel.mjs",
    "saas:up": "node scripts/saas-local/compose-with-nfs.mjs up -d --build --wait",
    "saas:down": "node scripts/saas-local/compose-with-nfs.mjs down",
    "saas:verify-isolation": "node scripts/saas-local/acceptance/verify-tenant-isolation.mjs",
    "saas:backup": "node scripts/saas-local/backup-compose-stack.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "esbuild": "0.28.1",
    "postject": "1.0.0-alpha.6",
    "puppeteer-core": "^25.3.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  }
}
