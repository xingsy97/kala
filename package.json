{
  "name": "agent-kernel",
  "version": "0.0.0",
  "private": true,
  "description": "Open-source, minimal, model-agnostic coding agent reference implementation. Core/executor decoupled, replay + fork built in.",
  "packageManager": "pnpm@11.3.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --parallel run build",
    "test": "pnpm -r --parallel run test",
    "typecheck": "pnpm -r --parallel run typecheck",
    "dev": "pnpm -r --parallel run dev",
    "executor:dev": "pnpm --filter @agent-kernel/executor dev",
    "publish:kernel": "pnpm --filter @agent-kernel/kernel run publish:npm",
    "publish:host": "pnpm --filter @agent-kernel/host run publish:npm",
    "publish:executor": "pnpm --filter @agent-kernel/executor run publish:npm",
    "publish:all": "pnpm run publish:kernel && pnpm run publish:host && pnpm run publish:executor"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "puppeteer-core": "^25.3.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  }
}
