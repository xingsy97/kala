{
  "name": "@agent-kernel/dashboard",
  "version": "0.0.0",
  "description": "Vite + React SPA that subscribes to an agent-kernel host over Socket.IO.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint:style": "node scripts/lint-style.mjs",
    "verify:real": "node ../../scripts/verify-dashboard-real.mjs",
    "verify:debugger": "node ../../scripts/verify-dashboard-debugger.mjs",
    "verify:layout-scroll": "node ../../scripts/verify-dashboard-layout-scroll.mjs",
    "verify:enhancement-actions": "node ../../scripts/verify-dashboard-enhancement-actions.mjs",
    "verify:subagent-scroll": "node ../../scripts/verify-dashboard-subagent-scroll.mjs"
  },
  "dependencies": {
    "@agent-kernel/kernel": "workspace:*",
    "@agent-kernel/shared": "workspace:*",
    "@formkit/auto-animate": "^0.9.0",
    "@radix-ui/react-alert-dialog": "^1.1.18",
    "@radix-ui/react-collapsible": "^1.1.15",
    "@radix-ui/react-dialog": "^1.1.18",
    "@radix-ui/react-scroll-area": "^1.2.13",
    "@radix-ui/react-select": "^2.3.2",
    "@radix-ui/react-slot": "^1.3.0",
    "@tanstack/react-query": "^5.101.2",
    "@uiw/react-json-view": "2.0.0-alpha.43",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "i18next": "^26.3.5",
    "lucide-react": "^1.23.0",
    "motion": "^12.42.2",
    "react": "^18.3.1",
    "react-arborist": "^3.13.0",
    "react-dom": "^18.3.1",
    "react-i18next": "^17.0.8",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^2.1.9",
    "react-use-measure": "^2.1.7",
    "react-virtuoso": "^4.18.10",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.3.1",
    "socket.io-client": "^4.8.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tanstack/react-query-devtools": "^5.101.2",
    "@testing-library/react": "^16.0.1",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.5"
  }
}
