{
  "name": "@agent-kernel/kernel",
  "version": "0.0.0",
  "description": "Pure-function reducer kernel for coding agents. Zero dependencies. < 500 lines.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "src", "README.md"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "publish:npm": "pnpm run build && pnpm publish --access public --no-git-checks"
  },
  "dependencies": {},
  "devDependencies": {
    "fast-check": "^4.9.0",
    "typescript": "^5.6.3",
    "vitest": "^3.2.6"
  },
  "sideEffects": false,
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
