{
  "name": "@agent-kernel/substrate",
  "version": "0.0.0",
  "description": "Self-improvement substrate: run a meta-agent auto-evolve loop over an agent's harness, judged by an out-of-loop evaluator. Sits entirely above the host's public API.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@agent-kernel/host": "workspace:*",
    "@agent-kernel/kernel": "workspace:*",
    "@agent-kernel/shared": "workspace:*",
    "ulid": "^2.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^3.2.6"
  },
  "sideEffects": false,
  "license": "MIT"
}
