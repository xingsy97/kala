{
  "name": "@agent-kernel/shared",
  "version": "0.0.0",
  "description": "Shared protocol types between core, executor, and dashboard.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./enhancement": {
      "types": "./dist/enhancement.d.ts",
      "import": "./dist/enhancement.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "publish:npm": "pnpm run build && pnpm publish --access public --no-git-checks"
  },
  "dependencies": {
    "@agent-kernel/kernel": "workspace:*",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  },
  "sideEffects": false,
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
