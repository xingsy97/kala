{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "kala-desktop",
  "version": "0.2.0-rc.13",
  "identifier": "io.github.xingsy97.akernel.desktop",
  "build": {
    "frontendDist": "../frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "launcher",
        "title": "Kala — Connect",
        "width": 560,
        "height": 430,
        "minWidth": 480,
        "minHeight": 380,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; media-src blob:; frame-src blob:; object-src 'none'; base-uri 'none'; form-action 'none'",
      "capabilities": ["launcher"]
    }
  },
  "bundle": {
    "active": true,
    "icon": ["icons/icon.png"],
    "targets": ["deb"],
    "category": "Development",
    "shortDescription": "Desktop client for an existing Kala Dashboard",
    "longDescription": "Linux remote-first Tauri client. Connects to your existing Kala Host; does not bundle or start a backend.",
    "homepage": "https://github.com/xingsy97/kala",
    "linux": {
      "deb": {
        "depends": ["libc6 (>= 2.39)", "xdg-utils", "libayatana-appindicator3-1"],
        "files": {
          "/usr/share/applications/io.github.xingsy97.akernel.desktop.desktop": "notification.desktop",
          "/usr/share/dbus-1/services/io.github.xingsy97.akernel.desktop.service": "desktop.service"
        },
        "desktopTemplate": "desktop.desktop",
        "section": "devel"
      }
    }
  }
}
