{
  "name": "@agent-kernel/host",
  "version": "0.2.0-rc.13",
  "description": "Kala Host runtime: model adapters, session store, and Socket.IO server.",
  "repository": { "type": "git", "url": "git+https://github.com/xingsy97/kala.git" },
  "homepage": "https://github.com/xingsy97/kala#readme",
  "bugs": { "url": "https://github.com/xingsy97/kala/issues" },
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "bin": {
    "agent-kernel-host": "./dist/bin/agent-kernel-host.js",
    "agent-runlab-runtime-service": "./dist/bin/agent-runlab-runtime-service.js",
    "agent-runlab-dedicated-ingress": "./dist/bin/agent-runlab-dedicated-ingress.js",
    "agent-runlab-dedicated-deploy-supervisor": "./dist/bin/agent-runlab-dedicated-deploy-supervisor.js"
  },
  "files": [
    "dist",
    "src",
    "bin",
    "README.md"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "dev": "tsx watch --exclude \"../dashboard/**\" bin/agent-kernel-host.ts",
    "dev:restart": "node ../../scripts/dev/restart-every.mjs --interval-ms 180000 -- tsx bin/agent-kernel-host.ts",
    "publish:npm": "pnpm run build && pnpm publish --access public --no-git-checks"
  },
  "dependencies": {
    "@agent-kernel/executor": "workspace:*",
    "@agent-kernel/kernel": "workspace:*",
    "@agent-kernel/shared": "workspace:*",
    "@aws-sdk/client-s3": "^3.1098.0",
    "@aws-sdk/s3-request-presigner": "^3.1098.0",
    "@github/copilot-sdk": "1.0.11",
    "@socket.io/admin-ui": "^0.5.1",
    "bcryptjs": "^2.4.3",
    "eventsource-parser": "^3.1.0",
    "fflate": "^0.8.3",
    "http-proxy": "^1.18.1",
    "jsonc-parser": "^3.3.1",
    "p-retry": "^8.0.0",
    "socket.io": "^4.8.1",
    "ulid": "^2.3.0",
    "web-push": "^3.6.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/http-proxy": "^1.17.17",
    "@types/node": "^22.9.0",
    "@types/web-push": "^3.6.4",
    "fast-check": "^4.9.0",
    "socket.io-client": "^4.8.1",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.21",
    "vitest": "^2.1.5"
  },
  "sideEffects": false,
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
