{
  "name": "@agent-kernel/host",
  "version": "0.0.0",
  "description": "Host runtime for the agent-kernel: LLM adapters, session store, Socket.IO server.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "agent-kernel-host": "./bin/agent-kernel-host.js"
  },
  "files": [
    "dist",
    "src",
    "bin",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "dev": "tsx watch --exclude \"../dashboard/**\" bin/agent-kernel-host.ts",
    "dev:restart": "node ../../scripts/dev/restart-every.mjs --interval-ms 180000 -- tsx bin/agent-kernel-host.ts",
    "publish:npm": "pnpm run build && pnpm publish --access public --no-git-checks"
  },
  "dependencies": {
    "@agent-kernel/executor": "workspace:*",
    "@agent-kernel/kernel": "workspace:*",
    "@agent-kernel/shared": "workspace:*",
    "@anthropic-ai/claude-agent-sdk": "^0.3.212",
    "@socket.io/admin-ui": "^0.5.1",
    "bcryptjs": "^2.4.3",
    "eventsource-parser": "^3.1.0",
    "fflate": "^0.8.3",
    "jsonc-parser": "^3.3.1",
    "p-retry": "^8.0.0",
    "socket.io": "^4.8.1",
    "ulid": "^2.3.0",
    "web-push": "^3.6.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.9.0",
    "@types/web-push": "^3.6.4",
    "fast-check": "^4.9.0",
    "socket.io-client": "^4.8.1",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.21",
    "vitest": "^2.1.5"
  },
  "sideEffects": false,
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
