{
  "name": "@agent-kernel/executor",
  "version": "0.0.0",
  "description": "Node executor: sandboxed tool runner that dials out to the agent-kernel host.",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "bin": {
    "agent-kernel-executor": "./dist/bin/agent-kernel-executor.js"
  },
  "files": [
    "dist",
    "src",
    "bin",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "dev": "tsx watch bin/agent-kernel-executor.ts",
    "dev:restart": "node ../../scripts/dev/restart-every.mjs --interval-ms 180000 -- tsx bin/agent-kernel-executor.ts",
    "publish:npm": "pnpm run build && pnpm publish --access public --no-git-checks"
  },
  "dependencies": {
    "@agent-kernel/kernel": "workspace:*",
    "@agent-kernel/shared": "workspace:*",
    "picomatch": "^4.0.2",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "proper-lockfile": "^4.1.2",
    "socket.io-client": "^4.8.1",
    "ulid": "^2.3.0"
  },
  "devDependencies": {
    "@agent-kernel/host": "workspace:*",
    "@types/node": "^22.9.0",
    "@types/picomatch": "^3.0.1",
    "@types/proper-lockfile": "^4.1.4",
    "socket.io-client": "^4.8.1",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  },
  "sideEffects": false,
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
