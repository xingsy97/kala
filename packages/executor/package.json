{
  "name": "@agent-kernel/executor",
  "version": "0.0.0",
  "description": "Node executor: sandboxed tool runner that dials out to the agent-kernel host.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "agent-kernel-executor": "./bin/agent-kernel-executor.js"
  },
  "files": ["dist", "src", "bin", "README.md"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "dev": "tsx bin/agent-kernel-executor.ts"
  },
  "dependencies": {
    "@agent-kernel/kernel": "workspace:*",
    "@agent-kernel/shared": "workspace:*",
    "picomatch": "^4.0.2",
    "socket.io-client": "^4.8.1",
    "ulid": "^2.3.0"
  },
  "devDependencies": {
    "@agent-kernel/host": "workspace:*",
    "@types/node": "^22.9.0",
    "@types/picomatch": "^3.0.1",
    "socket.io-client": "^4.8.1",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  },
  "sideEffects": false,
  "license": "MIT"
}
