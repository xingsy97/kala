FROM node:22-bookworm-slim AS build
RUN corepack enable && corepack prepare pnpm@11.3.0 --activate
WORKDIR /source
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json ./
COPY packages/eval-protocol/package.json packages/eval-protocol/package.json
COPY packages/eval-sdk/package.json packages/eval-sdk/package.json
COPY packages/eval-dashboard/package.json packages/eval-dashboard/package.json
RUN pnpm install --frozen-lockfile --filter @agent-kernel/eval-dashboard...
COPY packages/eval-protocol packages/eval-protocol
COPY packages/eval-sdk packages/eval-sdk
COPY packages/eval-dashboard packages/eval-dashboard
RUN pnpm --filter @agent-kernel/eval-protocol build \
  && pnpm --filter @agent-kernel/eval-sdk build \
  && pnpm --filter @agent-kernel/eval-dashboard build

FROM nginx:1.27-alpine
COPY --from=build /source/packages/eval-dashboard/dist /usr/share/nginx/html
COPY deploy/evaluation/nginx.conf /etc/nginx/conf.d/default.conf
ENTRYPOINT []
EXPOSE 8080
CMD ["nginx", "-g", "daemon off;"]
