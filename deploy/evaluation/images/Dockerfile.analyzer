FROM node:22-bookworm-slim AS build
RUN corepack enable && corepack prepare pnpm@11.3.0 --activate
WORKDIR /source
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json ./
COPY packages/eval-protocol/package.json packages/eval-protocol/package.json
COPY packages/eval-sdk/package.json packages/eval-sdk/package.json
COPY packages/eval-orchestrator/package.json packages/eval-orchestrator/package.json
COPY packages/eval-analyzer/package.json packages/eval-analyzer/package.json
RUN pnpm install --frozen-lockfile --filter @agent-kernel/eval-analyzer...
COPY packages/eval-protocol packages/eval-protocol
COPY packages/eval-sdk packages/eval-sdk
COPY packages/eval-orchestrator packages/eval-orchestrator
COPY packages/eval-analyzer packages/eval-analyzer
RUN pnpm --filter @agent-kernel/eval-protocol build && pnpm --filter @agent-kernel/eval-sdk build && pnpm --filter @agent-kernel/eval-orchestrator build && pnpm --filter @agent-kernel/eval-analyzer build
RUN pnpm deploy --legacy --filter @agent-kernel/eval-analyzer --prod /runtime

FROM node:22-bookworm-slim
ENV NODE_ENV=production
USER node
WORKDIR /runtime
COPY --from=build --chown=node:node /runtime ./
ENTRYPOINT ["node", "dist/bin/eval-analyzer.js"]
