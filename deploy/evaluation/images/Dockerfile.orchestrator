FROM node:22-bookworm-slim AS build
RUN corepack enable && corepack prepare pnpm@11.3.0 --activate
WORKDIR /source
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json ./
COPY packages/eval-protocol/package.json packages/eval-protocol/package.json
COPY packages/eval-sdk/package.json packages/eval-sdk/package.json
COPY packages/eval-orchestrator/package.json packages/eval-orchestrator/package.json
RUN pnpm install --frozen-lockfile --filter @agent-kernel/eval-orchestrator...
COPY packages/eval-protocol packages/eval-protocol
COPY packages/eval-sdk packages/eval-sdk
COPY packages/eval-orchestrator packages/eval-orchestrator
RUN pnpm --filter @agent-kernel/eval-protocol build \
  && pnpm --filter @agent-kernel/eval-sdk build \
  && pnpm --filter @agent-kernel/eval-orchestrator build
RUN pnpm deploy --legacy --filter @agent-kernel/eval-orchestrator --prod /runtime

FROM node:22-bookworm-slim
RUN install -d -o node -g node /var/lib/agent-evaluation
USER node
WORKDIR /opt/agent-evaluation
COPY --from=build --chown=node:node /runtime ./
COPY --chown=node:node deploy/evaluation/catalog.json ./catalog.json
COPY --chown=node:node deploy/evaluation/run-templates.json ./run-templates.json
COPY --chown=node:node docs/evidence/evaluation ./evidence
EXPOSE 13100
ENTRYPOINT ["node", "dist/bin/eval-orchestrator.js"]
CMD ["--host", "0.0.0.0", "--data-dir", "/var/lib/agent-evaluation"]
