# Copy to a Git-ignored deployment.env and use: docker compose --env-file deploy/evaluation/deployment.env ...
AGENT_EVAL_BIND_ADDRESS=127.0.0.1
AGENT_EVAL_PORT=13100
AGENT_EVAL_DASHBOARD_PORT=13180
AGENT_EVAL_MODEL_ENDPOINT_AUTHORITY=model-gateway.example.internal:3000
AGENT_EVAL_LXD_IMAGE=local:reviewed-base-alias
AGENT_EVAL_SWE_BENCH_LXD_IMAGE=local:reviewed-swe-bench-alias

# Secret files must be outside Git and readable only by the deployment operator.
AGENT_EVAL_AUTH_CONFIG_FILE=/etc/agent-evaluation/secrets/auth-config.json
AGENT_EVAL_TRUST_CONFIG_FILE=/etc/agent-evaluation/secrets/trust-config.json
AGENT_EVAL_WORKER_TOKEN_FILE=/etc/agent-evaluation/secrets/worker.token
AGENT_EVAL_ANALYZER_TOKEN_FILE=/etc/agent-evaluation/secrets/analyzer.token
# This service token must contain query/read scopes only; browser mutations use the signed-in user's credential.
AGENT_EVAL_DASHBOARD_READ_TOKEN_FILE=/etc/agent-evaluation/secrets/dashboard-read.token
AGENT_EVAL_WORKER_SIGNING_KEY_FILE=/etc/agent-evaluation/secrets/worker-signing-key.pem
AGENT_EVAL_ANALYZER_SIGNING_KEY_FILE=/etc/agent-evaluation/secrets/analyzer-signing-key.pem
AGENT_EVAL_DOCKER_MODEL_SETTINGS_FILE=/etc/agent-evaluation/secrets/docker-model-settings.json
AGENT_EVAL_LXD_MODEL_SETTINGS_FILE=/etc/agent-evaluation/secrets/lxd-model-settings.json

# Set only the socket group needed by the selected Worker profile.
AGENT_EVAL_DOCKER_GID=999
AGENT_EVAL_LXD_GID=998
# AGENT_EVAL_LXC_BIN=/snap/lxd/current/bin/lxc
# AGENT_EVAL_LXD_SOCKET=/var/snap/lxd/common/lxd/unix.socket
