[Unit]
Description=Agent RunLab one-shot migration finalizer
After=network-online.target agent-runlab-host.service
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=-/etc/agent-runlab/migration.env
ExecStart=/usr/bin/node /opt/agent-runlab/control/cutover-standalone-systemd.mjs
TimeoutStartSec=0
TimeoutStopSec=30s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/agent-runlab /home/ubuntu /etc/systemd/system /etc/agent-runlab
CapabilityBoundingSet=CAP_CHOWN CAP_DAC_OVERRIDE CAP_DAC_READ_SEARCH CAP_FOWNER
UMask=0077
