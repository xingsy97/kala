FROM node@sha256:048ed02c5fd52e86fda6fbd2f6a76cf0d4492fd6c6fee9e2c463ed5108da0e34 AS build
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends python3 make g++ && rm -rf /var/lib/apt/lists/*
RUN corepack enable && corepack prepare pnpm@11.3.0 --activate
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json ./
COPY packages/kernel/package.json packages/kernel/package.json
COPY packages/shared/package.json packages/shared/package.json
COPY packages/executor/package.json packages/executor/package.json
COPY packages/host/package.json packages/host/package.json
COPY packages/runtime-ingress-gateway/package.json packages/runtime-ingress-gateway/package.json
COPY packages/dashboard/package.json packages/dashboard/package.json
RUN pnpm install --frozen-lockfile --filter @agent-kernel/host... --filter @agent-kernel/runtime-ingress-gateway... --filter @agent-kernel/dashboard...
COPY packages/kernel packages/kernel
COPY packages/shared packages/shared
COPY packages/executor packages/executor
COPY packages/host packages/host
COPY packages/runtime-ingress-gateway packages/runtime-ingress-gateway
COPY packages/dashboard packages/dashboard
COPY docs docs
COPY deploy/dedicated-systemd deploy/dedicated-systemd
COPY scripts/deploy scripts/deploy
COPY scripts/release scripts/release
COPY resources resources
RUN pnpm --filter @agent-kernel/kernel build && pnpm --filter @agent-kernel/shared build && pnpm --filter @agent-kernel/executor build && pnpm --filter @agent-kernel/host build && pnpm --filter @agent-kernel/runtime-ingress-gateway build && pnpm --filter @agent-kernel/dashboard build
ARG SOURCE_REVISION
RUN node scripts/release/build-release-assets.mjs --no-native --repo local/agent-runlab --skip-dashboard-build --skip-package-build --source-revision "$SOURCE_REVISION"
RUN rm -rf packages/dashboard && rm -f release/agent-kernel-dashboard-dist.tar.gz release/dashboard-release.json docs/.tracked-release-docs

FROM node@sha256:048ed02c5fd52e86fda6fbd2f6a76cf0d4492fd6c6fee9e2c463ed5108da0e34 AS runtime
ENV NODE_ENV=production
WORKDIR /app
RUN groupadd --system --gid 10001 runlab && useradd --system --uid 10001 --gid runlab --home /nonexistent --shell /usr/sbin/nologin runlab
COPY --from=build --chown=runlab:runlab /app /app
USER 10001:10001
CMD ["node", "packages/host/dist/bin/agent-runlab-runtime-service.js"]
