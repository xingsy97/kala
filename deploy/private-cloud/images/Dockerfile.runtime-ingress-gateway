FROM node@sha256:43ac6c60b8f89723f746e8a92ce91abd5017e627ce1ddfe4238355d3a30b772c AS build
WORKDIR /app
RUN corepack enable && corepack prepare pnpm@11.3.0 --activate
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json ./
COPY packages/runtime-ingress-gateway/package.json packages/runtime-ingress-gateway/package.json
COPY packages/shared/package.json packages/shared/package.json
COPY packages/kernel/package.json packages/kernel/package.json
RUN pnpm install --frozen-lockfile --filter @agent-kernel/runtime-ingress-gateway...
COPY packages/runtime-ingress-gateway packages/runtime-ingress-gateway
COPY packages/shared packages/shared
COPY packages/kernel packages/kernel
RUN pnpm --filter @agent-kernel/kernel build && pnpm --filter @agent-kernel/shared build && pnpm --filter @agent-kernel/runtime-ingress-gateway build
RUN pnpm deploy --legacy --filter @agent-kernel/runtime-ingress-gateway --prod /out/ingress \
 && rm -rf /out/ingress/src

FROM node@sha256:43ac6c60b8f89723f746e8a92ce91abd5017e627ce1ddfe4238355d3a30b772c AS runtime
ENV NODE_ENV=production
WORKDIR /app
RUN groupadd --system --gid 10001 runlab && useradd --system --uid 10001 --gid runlab --home /nonexistent --shell /usr/sbin/nologin runlab
COPY --from=build --chown=runlab:runlab /out/ingress/ /app/packages/runtime-ingress-gateway/
USER 10001:10001
CMD ["node", "packages/runtime-ingress-gateway/dist/src/bin/agent-runlab-runtime-ingress.js"]
